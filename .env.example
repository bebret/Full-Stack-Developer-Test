# Salin file ini menjadi .env lalu sesuaikan bila perlu.

# Port REST API
PORT=3001

# Koneksi PostgreSQL (harus sama dengan docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5432/transactiondb

# Sumber data JSON untuk seeding, relatif terhadap folder server/
DATA_FILE=../viewData.json
